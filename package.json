{
  "name": "lens-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wgsl": "node scripts/build-wgsl.mjs",
    "build:lenses": "node scripts/build-lens-data.mjs",
    "prepare": "node scripts/build-wgsl.mjs",
    "predev": "npm run build:wgsl && npm run build:lenses",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run build:wgsl && npm run build:lenses",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run build:wgsl && npm run build:lenses",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "polygon-clipping": "^0.15.7",
    "vite": "^7.1.0",
    "three": "^0.186.0"
  },
  "exports": {
    ".": "./src/lens-tracer.js",
    "./tracer": "./src/lens-tracer.js",
    "./three": "./src/rendering/three-interop.js",
    "./garden-provider": "./src/rendering/garden-provider.js",
    "./lighting": "./src/rendering/lighting-resources.js",
    "./radiance-provider": "./src/rendering/radiance-provider.js",
    "./scene-source": "./src/scene/scene-source.js",
    "./scene-extract": "./src/scene/scene-extract.js",
    "./lens-library": "./src/optics/lens-library.js",
    "./workers/bvh": "./src/scene/bvh-worker.js",
    "./workers/pupil": "./src/optics/pupil-worker.js",
    "./workers/focus": "./src/optics/focus-worker.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  }
}
